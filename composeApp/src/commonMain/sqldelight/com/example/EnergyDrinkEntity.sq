CREATE TABLE EnergyDrinkEntity(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    amount INTEGER NOT NULL,
    description TEXT,
    rating INTEGER,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    imagePath TEXT
);

insertEnergyDrink:
INSERT INTO EnergyDrinkEntity(name, amount,description, rating, createdAt, updatedAt, imagePath)
VALUES (?,?,?,?,?,?,?);

updateEnergyDrink:
UPDATE EnergyDrinkEntity
SET name = ?, amount = ?, description = ?, rating = ?, updatedAt = ?, imagePath = ?
WHERE id = ?;

deleteEnergyDrink:
DELETE FROM EnergyDrinkEntity WHERE id = ?;


selectById:
SELECT * FROM EnergyDrinkEntity WHERE id = ?;

selectAll:
SELECT * FROM EnergyDrinkEntity;

lastInsertRowId:
SELECT last_insert_rowid();