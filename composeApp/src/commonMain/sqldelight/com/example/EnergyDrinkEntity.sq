CREATE TABLE EnergyDrinkEntity(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    amount INTEGER NOT NULL,
    description TEXT,
    rating INTEGER,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    imagePath TEXT
);

selectById:
SELECT * FROM EnergyDrinkEntity WHERE id = ?;

selectAll:
SELECT * FROM EnergyDrinkEntity;
