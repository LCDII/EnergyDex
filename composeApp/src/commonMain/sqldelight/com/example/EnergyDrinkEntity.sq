CREATE TABLE EnergyDrinkEntity(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    amount INTEGER NOT NULL,
    description TEXT,
    rating REAL,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);


CREATE INDEX idx_energy_createdAt ON EnergyDrinkEntity(createdAt);
CREATE INDEX idx_energy_rating ON EnergyDrinkEntity(rating);
CREATE INDEX idx_energy_name ON EnergyDrinkEntity(name);

insertEnergyDrink:
INSERT INTO EnergyDrinkEntity(name, amount,description, rating, createdAt, updatedAt)
VALUES (?,?,?,?,?,?);

updateEnergyDrink:
UPDATE EnergyDrinkEntity
SET name = ?, amount = ?, description = ?, rating = ?, updatedAt = ?
WHERE id = ?;

deleteEnergyDrink:
DELETE FROM EnergyDrinkEntity WHERE id = ?;

selectById:
SELECT * FROM EnergyDrinkEntity WHERE id = ?;

observeEnergyDrinks:
SELECT * FROM EnergyDrinkEntity
WHERE :nameQuery = '' OR name LIKE :nameQuery || '%'
ORDER BY
    CASE :sortOption
        WHEN 'DATE_DESC' THEN createdAt
        WHEN 'RATING_DESC' THEN rating
        WHEN 'TITLE_DESC' THEN name
    END DESC,
    CASE :sortOption
        WHEN 'DATE_ASC' THEN createdAt
        WHEN 'RATING_ASC' THEN rating
        WHEN 'TITLE_ASC' THEN name
    END ASC;

lastInsertRowId:
SELECT last_insert_rowid();
