CREATE TABLE EnergyDrinkTag (
    energyDrinkId INTEGER NOT NULL REFERENCES EnergyDrinkEntity(id) ON UPDATE CASCADE ON DELETE CASCADE,
    tagId INTEGER NOT NULL REFERENCES TagEntity(id) ON UPDATE CASCADE ON DELETE CASCADE,
    PRIMARY KEY (energyDrinkId, tagId)
);


insertEnergyDrinkTag:
INSERT OR IGNORE INTO EnergyDrinkTag(energyDrinkId, tagId) VALUES (?, ?);

deleteEnergyDrinkTag:
DELETE FROM EnergyDrinkTag WHERE energyDrinkId = ? AND tagId = ?;

deleteAllTagsForEnergyDrink:
DELETE FROM EnergyDrinkTag WHERE energyDrinkId = ?;

selectTagsForEnergyDrink:
SELECT TagEntity.*
FROM TagEntity
INNER JOIN EnergyDrinkTag ON TagEntity.id = EnergyDrinkTag.tagId
WHERE EnergyDrinkTag.energyDrinkId = ?;

selectEnergyDrinksForTag:
SELECT EnergyDrinkEntity.*
FROM EnergyDrinkEntity
INNER JOIN EnergyDrinkTag ON EnergyDrinkEntity.id = EnergyDrinkTag.energyDrinkId
WHERE EnergyDrinkTag.tagId = ?
  AND (:nameQuery = '' OR EnergyDrinkEntity.name LIKE :nameQuery || '%')
ORDER BY
    CASE :sortOption
        WHEN 'DATE_DESC' THEN createdAt
        WHEN 'RATING_DESC' THEN rating
        WHEN 'TITLE_DESC' THEN name
    END DESC,
    CASE :sortOption
        WHEN 'DATE_ASC' THEN createdAt
        WHEN 'RATING_ASC' THEN rating
        WHEN 'TITLE_ASC' THEN name
    END ASC;

selectAllRelations:
SELECT * FROM EnergyDrinkTag;
